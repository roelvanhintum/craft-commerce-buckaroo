{
  "name": "roelvanhintum/craft-commerce-buckaroo",
  "description": "Buckaroo Gateway for Craft Commerce",
  "type": "craft-plugin",
  "keywords": [
    "buckaroo",
    "commerce",
    "craftcms",
    "omnipay"
  ],
  "license": "MIT",
  "authors": [
    {
      "name": "Roel van Hintum",
      "homepage": "https://roel.vanhintum.eu/"
    },
    {
      "name": "Born05",
      "homepage": "https://www.born05.com/"
    }
  ],
  "require": {
    "php": "^8.0.2",
    "craftcms/cms": "^4.0.0-alpha|^5.0.0-beta.1",
    "craftcms/commerce": "^4.0.0-beta.2|^5.0.0-beta.1",
    "craftcms/commerce-omnipay": "^4.1.0",
    "roelvanhintum/omnipay-buckaroo": "~3.0"
  },
  "require-dev": {
    "craftcms/phpstan": "dev-main",
    "squizlabs/php_codesniffer": "3.*"
  },
  "autoload": {
    "psr-4": {
      "roelvanhintum\\commerce\\buckaroo\\": "src/"
    }
  },
  "support": {
    "issues": "https://github.com/roelvanhintum/craft-commerce-buckaroo/issues",
    "source": "https://github.com/roelvanhintum/craft-commerce-buckaroo",
    "docs": "https://github.com/roelvanhintum/craft-commerce-buckaroo/blob/master/README.md",
    "rss": "https://github.com/roelvanhintum/craft-commerce-buckaroo/releases.atom"
  },
  "extra": {
    "name": "Buckaroo for Craft Commerce",
    "handle": "commerce-buckaroo"
  },
  "config": {
    "allow-plugins": {
      "php-http/discovery": true,
      "yiisoft/yii2-composer": true,
      "craftcms/plugin-installer": true
    }
  }
}